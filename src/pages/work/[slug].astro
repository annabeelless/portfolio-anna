---
import Base from '../../layouts/Base.astro';
import IndexRow from '../../components/IndexRow.astro';
import HelloAds from '../../components/HelloAds.astro';
import Chapters from '../../components/Chapters.astro';
import Videos from '../../components/Videos.astro';
import { site, projects, rel, pad } from '../../lib/data.js';
import { img } from '../../lib/img.js';
export function getStaticPaths() { return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, others: [...projects.slice(i + 1), ...projects.slice(0, i)].filter((o) => !o.placeholder && (o.feed.length || o.cover)).slice(0, 3) } })); }
const { p, others } = Astro.props; const u = rel(1);
import fs from 'node:fs';
const wide = (() => {
  if (!p.wideImage) return null;
  const v = [1280, 2048, 3200].map((w) => [w, p.wideImage.replace(/(\.\w+)$/, `-${w}$1`)]).filter(([, f]) => fs.existsSync(`public${f}`));
  return { src: u(v.length ? v[v.length - 1][1] : p.wideImage), srcset: v.length ? v.map(([w, f]) => `${u(f)} ${w}w`).join(', ') : undefined };
})();
const steps = [['Task', p.task], ['My role', p.role], ['Approach', p.approach]];
const blocks = [['feed', 'Feed', p.feed, '4:5'], ['stories', 'Stories', p.stories, '9:16'], ['ads', 'Ad creatives', p.ads, '']].filter((b) => b[2].length);
---
<Base title={`${p.title} ${p.subtitle} - ${site.name}`} depth={1} page="projects">
<div class="case" style={`--accent:${p.accent}`}>
  <div class={p.wideImage ? 'case__stage' : 'case__nostage'}>
  {p.wideImage && <div class="case__wbg" aria-hidden="true" data-herobg><img src={wide.src} srcset={wide.srcset} sizes="(max-width: 860px) 220vw, 100vw" alt="" fetchpriority="high" decoding="async" /></div>}
  <section class={`case__head ${p.heroImage ? 'case__head--hero' : ''}`}>
    {p.heroImage && <div class="case__bg" aria-hidden="true" data-herobg><img src={u(p.heroImage)} alt="" /></div>}
    <div class="case__htop">
      <p class="mono muted" data-load>[ {p.category} ]</p>
      <h1 class="case__title" data-load style="--d:.15s">{p.title}</h1>
      <p class="case__sub" data-load style="--d:.3s"><em>{p.subtitle}</em></p>
    </div>
    {!p.heroImage && !p.wideImage && p.sideImage && <figure class="case__side" data-load style="--d:.35s"><img src={u(p.sideImage)} alt={`${p.title} - ${p.subtitle}`} data-zoom /></figure>}
    {p.heroImage && p.heroText && (
      <div class="case__hnote" data-load style="--d:.5s">
        <p>{p.heroText}</p>
        {p.heroMeta && <ul class="mono">{p.heroMeta.map((m) => <li>{m}</li>)}</ul>}
      </div>
    )}
  </section>
  {p.wideImage && <p class="case__lead case__lead--stage" data-load style="--d:.45s">{p.summary}</p>}
  </div>

  {p.chapters?.length > 0 && (
  <section class={`case__about ${p.wideImage ? 'case__about--nolead' : ''}`}>
    {!p.wideImage && <p class="case__lead reveal">{p.summary}</p>}
    <div class="steps">{steps.map(([h, t], i) => <div class="step reveal" style={`--i:${i}`}><p class="mono muted">({pad(i + 1)}) {h}</p><p>{t}</p></div>)}</div>
    {p.stats && <div class="stats">{p.stats.map((s, i) => <div class="reveal" style={`--i:${i}`}><b>{s.value}</b><span class="mono muted">{s.label}</span></div>)}</div>}
  </section>
  )}
  {p.scopeTop && (
  <section class="block scope" id="scope">
    <div class="block__head reveal"><h2 class="h2">{p.scopeTitle || 'Scope of work'}</h2>{p.scopeTop && <p class="mono muted">[ {p.scope.length} areas ]</p>}</div>
    <ol class={`scope__list ${p.scopeTop ? 'scope__list--full' : ''}`}>{p.scope.map((s, i) => { const k = s.indexOf(' - '); return <li class="reveal"><span class="mono muted">({pad(i + 1)})</span>{k > 0 ? <span class="scope__row"><b>{s.slice(0, k)}</b><span>{s.slice(k + 3)}</span></span> : s}</li>; })}</ol>
    {p.results && <p class="scope__results reveal"><span class="mono muted">[ Results ]</span>{p.results}</p>}
  </section>
  )}
  {p.chapters && p.chapters.length > 0 && <Chapters p={p} u={u} />}

  {(p.feed.length || p.wall) ? (
    <section class="case__wall" data-load style="--d:.45s" data-parallax><div class="case__wallrow">{(p.wall || p.feed.slice(0, 3)).map((src) => <img src={img(src, u).src} data-full={u(src)} alt="" data-zoom />)}</div></section>
  ) : p.chapters?.length ? null : (
    <section class="case__wall case__wall--ph" data-load style="--d:.45s"><span class="mono muted">[ Videos, feed and creatives are coming soon ]</span></section>
  )}

  <section class="passport mono reveal">
    <div><span class="muted">Client</span><b>{p.client}</b></div>
    {p.position && <div><span class="muted">Position</span><b>{p.position}</b></div>}
    <div><span class="muted">Year</span><b>{p.year || '-'}</b></div>
    <div><span class="muted">Industry</span><b>{p.industry}</b></div>
    <div><span class="muted">Services</span><ul>{p.services.map((s) => <li>{s}</li>)}</ul></div>
  </section>

  {!(p.chapters?.length > 0) && (
  <section class="case__about">
    <p class="case__lead reveal">{p.summary}</p>
    <div class="steps">{steps.map(([h, t], i) => <div class="step reveal" style={`--i:${i}`}><p class="mono muted">({pad(i + 1)}) {h}</p><p>{t}</p></div>)}</div>
    {p.stats && <div class="stats">{p.stats.map((s, i) => <div class="reveal" style={`--i:${i}`}><b>{s.value}</b><span class="mono muted">{s.label}</span></div>)}</div>}
  </section>
  )}


  {(p.videos?.length > 0 || p.slug === 'hello') && <Videos p={p} u={u} />}

  {p.slug === 'hello' && <HelloAds u={u} />}

  {blocks.map(([id, h, list, ratio]) => (
    <section class="block" id={id}>
      <div class="block__head reveal"><h2 class="h2">{h}</h2><p class="mono muted">[ {list.length}{ratio ? ` - ${ratio}` : ''} ]</p></div>
      {id === 'feed' && <div class="feedgrid">{list.map((src, i) => <img class="reveal" style={`--i:${i % 3}`} src={u(src)} alt={`${p.title} feed post`} loading="lazy" data-zoom />)}</div>}
      {id === 'stories' && <div class="stories" data-drag>{list.map((src, i) => <figure class="story reveal" style={`--i:${i}`}><img src={img(src, u).src} data-full={u(src)} width={img(src, u).w} height={img(src, u).h} alt={`${p.title} story ${i + 1}`} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false" data-zoom /><figcaption class="mono muted">({pad(i + 1)})</figcaption></figure>)}</div>}
      {id === 'ads' && <div class="stories adrow" data-drag>{list.map((src, i) => <figure class="story adrow__item reveal" style={`--i:${i}`}><img src={img(src, u).src} data-full={u(src)} width={img(src, u).w} height={img(src, u).h} alt={`${p.title} ad creative ${i + 1}`} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false" data-zoom /><figcaption class="mono muted">({pad(i + 1)})</figcaption></figure>)}</div>}
    </section>))}

  {p.extras && p.extras.length > 0 && (
    <section class="block" id="extras">
      <div class="block__head reveal"><h2 class="h2">{p.extrasTitle}</h2><p class="mono muted">[ {p.extras.length} ]</p></div>
      {p.extrasKind === 'event'
        ? <div class="stories adrow" data-drag>{p.extras.map((src, i) => <figure class="story adrow__item reveal" style={`--i:${i}`}><img src={img(src, u).src} data-full={u(src)} width={img(src, u).w} height={img(src, u).h} alt={`${p.title} ${p.extrasTitle} ${i + 1}`} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false" data-zoom /><figcaption class="mono muted">({pad(i + 1)})</figcaption></figure>)}</div>
        : <div class={`extras extras--${p.extrasKind}`}>{p.extras.map((src) => <img class="reveal" src={u(src)} alt="" loading="lazy" data-zoom />)}</div>}
    </section>)}

  {!p.scopeTop && (
  <section class="block scope" id="scope">
    <div class="block__head reveal"><h2 class="h2">{p.scopeTitle || 'Scope of work'}</h2>{p.scopeTop && <p class="mono muted">[ {p.scope.length} areas ]</p>}</div>
    <ol class={`scope__list ${p.scopeTop ? 'scope__list--full' : ''}`}>{p.scope.map((s, i) => { const k = s.indexOf(' - '); return <li class="reveal"><span class="mono muted">({pad(i + 1)})</span>{k > 0 ? <span class="scope__row"><b>{s.slice(0, k)}</b><span>{s.slice(k + 3)}</span></span> : s}</li>; })}</ol>
    {p.results && <p class="scope__results reveal"><span class="mono muted">[ Results ]</span>{p.results}</p>}
  </section>
  )}

  {p.testimonial && (
  <section class="quote">
    <p class="mono muted reveal">[ Testimonial ]</p>
    <blockquote class="reveal">“{p.testimonial.text}”</blockquote>
    <p class="quote__who reveal"><b>{p.testimonial.name}</b>{p.testimonial.position && <span class="muted"> ({p.testimonial.position})</span>}</p>
  </section>
  )}

  <section class="others">
    <div class="others__head"><div><h2 class="h2 reveal">Other projects</h2><p class="mono muted reveal">Keep exploring</p></div><a class="filter filter--link reveal" href={u('index.html#projects')}>All projects →</a></div>
    <ul class="ix__list ix__list--mini" data-ix>{others.map((o) => <IndexRow p={o} n={projects.indexOf(o) + 1} depth={1} />)}</ul>
    <div class="ix__float" aria-hidden="true"><img alt="" /></div>
  </section>
</div>
<div class="lightbox" data-lightbox hidden>
  <img alt="" />
  <video class="lightbox__video" controls playsinline hidden></video>
  <button class="lightbox__btn lightbox__close" type="button" data-lb-close aria-label="Close">Close</button>
  <button class="lightbox__btn lightbox__prev" type="button" data-lb-prev aria-label="Previous">←</button>
  <button class="lightbox__btn lightbox__next" type="button" data-lb-next aria-label="Next">→</button>
  <span class="lightbox__count mono" data-lb-count></span>
</div>
</Base>
